#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$REPO_DIR/dotfiles-cli/Cargo.toml"

if ! command -v cargo >/dev/null 2>&1; then
    echo "Rust is required to build the dotfiles TUI." >&2
    echo "Run ./bootstrap.sh first, or install rustup." >&2
    exit 127
fi

exec cargo run --quiet --release --manifest-path "$MANIFEST" -- --repo "$REPO_DIR" "$@"
