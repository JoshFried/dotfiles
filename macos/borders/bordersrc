#!/bin/bash
# JankyBorders reads these settings when the service starts. The active and inactive
# outline colors below follow the Kanagawa palette.


# Kanagawa Wave colors
# Active:   crystalBlue #7E9CD8 (bright, visible)
# Inactive: sumiInk5    #363646 (subtle)

options=(
    style=square
    width=9.0
    hidpi=on
    active_color=0xff5f7a56
    inactive_color=0xff363646
)

borders "${options[@]}"
